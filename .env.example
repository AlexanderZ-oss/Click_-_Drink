# Copia este archivo como plantilla. El .env real NO se sube a GitHub.

# --- Vercel: agrega también estas variables en Project Settings > Environment Variables ---

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary (cuenta gratis en cloudinary.com)
# Cloud name: Dashboard > Settings > Product Environment Info
VITE_CLOUDINARY_CLOUD_NAME=
# Preset: Dashboard > Settings > Upload > Upload Presets > nuevo con modo "Unsigned"
VITE_CLOUDINARY_UPLOAD_PRESET=

# Stripe (cuando pases a producción con cobro real)
VITE_STRIPE_PUBLISHABLE_KEY=
